# ==========================================================================
#  FORA – Ρυθμίσεις Next.js (frontend)
#  ΤΟΠΙΚΑ: αντιγράψτε το σε αρχείο ".env.local".
#  ΣΤΟΝ ΔΙΑΚΟΜΙΣΤΗ: οι τιμές δίνονται από το Portainer / docker-compose.
# ==========================================================================

# ΔΗΜΟΣΙΑ διεύθυνση του Strapi — τη χρησιμοποιεί ο browser του επισκέπτη για
# να φορτώσει εικόνες/αρχεία. ΠΡΕΠΕΙ να είναι προσβάσιμη από το internet.
# Παράδειγμα στον διακομιστή: http://SERVER_IP:1337
# ΠΡΟΣΟΧΗ: «ψήνεται» στην εικόνα κατά το build — αν αλλάξει, ξαναχτίστε το frontend.
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# ΕΣΩΤΕΡΙΚΗ διεύθυνση (μόνο μέσα στο Docker) για τις κλήσεις από τον διακομιστή.
# Μέσα στο compose τα containers βρίσκονται με το όνομα της υπηρεσίας.
# Τοπικά αφήστε το κενό/σχολιασμένο.
# STRAPI_INTERNAL_URL=http://backend:1337

# Κάθε πόσα δευτερόλεπτα ξανα-διαβάζεται το περιεχόμενο από το Strapi.
CONTENT_REVALIDATE_SECONDS=60

# Η δημόσια διεύθυνση του ιστότοπου (για SEO).
NEXT_PUBLIC_SITE_URL=http://localhost:4321

# Ο σύνδεσμος των γραμματοσειρών Adobe Fonts (Typekit).
NEXT_PUBLIC_TYPEKIT_URL=https://use.typekit.net/njw0ocx.css
