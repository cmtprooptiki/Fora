# ==========================================================================
#  FORA – Ρυθμίσεις Strapi (backend)
#  ΤΟΠΙΚΑ: αντιγράψτε το σε αρχείο ".env" και βάλτε πραγματικές τιμές.
#  ΣΤΟΝ ΔΙΑΚΟΜΙΣΤΗ: μην φτιάξετε .env — βάλτε τις τιμές στο Portainer
#  (Stack → Environment variables). Το .env ΔΕΝ ανεβαίνει ποτέ στο git.
# ==========================================================================

# --- Διακομιστής ---
HOST=0.0.0.0
PORT=1337

# --- Μυστικά κλειδιά (ΟΛΑ ΥΠΟΧΡΕΩΤΙΚΑ) ---
# Το APP_KEYS θέλει 4 τυχαία κλειδιά χωρισμένα με κόμμα. Δημιουργήστε τα με:
#   node -e "console.log([1,2,3,4].map(()=>require('crypto').randomBytes(16).toString('base64')).join(','))"
# Τα υπόλοιπα (ένα τυχαίο το καθένα) με:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=changeme
ADMIN_JWT_SECRET=changeme
TRANSFER_TOKEN_SALT=changeme
JWT_SECRET=changeme
ENCRYPTION_KEY=changeme

# --- Βάση δεδομένων (SQLite) ---
# ΤΟΠΙΚΑ αφήστε τη σχετική διαδρομή.
# ΣΤΟ DOCKER βάλτε ΑΠΟΛΥΤΗ διαδρομή: /app/.tmp/data.db
# ώστε το αρχείο της βάσης να είναι πάντα μέσα στον μόνιμο τόμο (volume).
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# --- Ποιες ιστοσελίδες επιτρέπεται να διαβάζουν το περιεχόμενο (CORS) ---
# Βάλτε τη διεύθυνση του δημόσιου ιστότοπου (χωρισμένες με κόμμα).
# Παράδειγμα στον διακομιστή: http://SERVER_IP:3003
CORS_ORIGINS=http://localhost:4321
